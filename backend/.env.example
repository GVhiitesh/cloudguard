# Port and Environment
PORT=4000
NODE_ENV=development

# Database Connection (Neon Serverless PostgreSQL or Local)
# Use your Assignment 1 cloud database pooler URI with sslmode=require
DATABASE_URL=postgresql://<user>:<password>@<ep-xyz>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://<user>:<password>@<ep-xyz>.<region>.aws.neon.tech/neondb?sslmode=require

# Authentication & JWT Configuration
JWT_SECRET=your_secure_random_jwt_secret_min_32_characters_long
JWT_EXPIRES_IN=1d

# FinOps Governance & Anomaly Detection Parameters
IDLE_CPU_THRESHOLD=5
IDLE_WINDOW_DAYS=10
ANOMALY_WINDOW_DAYS=14
ANOMALY_MIN_ABS_DELTA=20
IDLE_FLAG_AFTER_DAYS=15

# Background Workers & Simulation
SIMULATOR_ENABLED=false
CORS_ORIGIN=*
LOG_LEVEL=info
