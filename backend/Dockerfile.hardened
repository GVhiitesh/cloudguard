# ── Build Stage ──
FROM node:22-alpine AS builder

WORKDIR /app

RUN apk add --no-cache openssl

COPY package*.json ./
RUN npm ci

COPY prisma ./prisma
RUN npx prisma generate

COPY tsconfig.json ./
COPY src ./src

RUN npm run build

# Remove development dependencies and clean cache
RUN npm prune --omit=dev && npm cache clean --force

# ── Production Runtime Stage (Hardened Minimal Image) ──
FROM node:22-alpine AS runner

WORKDIR /app

# Install minimal runtime library for Prisma engine
RUN apk add --no-cache openssl && rm -rf /var/cache/apk/*

ENV NODE_ENV=production
ENV PORT=4000

# Copy built application and pruned production node_modules only
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma

# Enforce least privilege with non-root user
USER node

EXPOSE 4000

CMD ["node", "dist/src/server.js"]
